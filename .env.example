# GitSole Environment Variables Configuration

# Supabase Cloud Database (Get these from https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: Google Gemini AI Key (for backend concierge assistant API)
GEMINI_API_KEY=your_gemini_api_key_here
